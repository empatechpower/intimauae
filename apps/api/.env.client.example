# Client Supabase — paste values here, then tell the developer to run migration.
# Do NOT commit this file (gitignored).

# From client Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From client Supabase → Project Settings → Database → Connection string (URI)
# Prefer Transaction pooler :6543
DATABASE_URL=

# Optional direct connection for big imports
DATABASE_URL_DIRECT=

# Catalog USD → Uniwebpay SGD. Example: $50 × 1.35 = 67.50 SGD charged
USD_TO_SGD_RATE=1.35
