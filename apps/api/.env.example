# API — never commit real secrets. Set these in Vercel → Settings → Environment Variables.

NODE_ENV=production
PORT=4123

# Public site URL (client domain on Vercel)
APP_URL=https://YOUR-STORE.vercel.app
# API public URL (if API is a separate Vercel project)
API_URL=https://YOUR-API.vercel.app
# Extra CORS origins (comma-separated) if needed
CORS_ORIGIN=

# Client Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — prefer Transaction pooler :6543; optional direct fallback
DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# MUST be 0 or unset in production (never bypass admin auth)
ADMIN_DEV_BYPASS=0

# Uniwebpay / Checkout.com Frames
UNIWEBPAY_STORE_ID=
UNIWEBPAY_PRIVATE_KEY_PKCS8=
UNIWEBPAY_KEY_VERSION=1
UNIWEBPAY_BASE_URL=https://app.uniwebpay.com
UNIWEBPAY_NOTIFY_URL=https://YOUR-API.vercel.app/api/payments/webhook
UNIWEBPAY_WEBHOOK_SECRET=
CHECKOUT_FRAMES_PK=

# Catalog is USD; Uniwebpay charges SGD. Example: $50 × 1.35 = 67.50 SGD
USD_TO_SGD_RATE=1.35

# Rate limits (requests per window — optional overrides)
RATE_LIMIT_GLOBAL=180
RATE_LIMIT_PAYMENT=20
RATE_LIMIT_CONTACT=8
RATE_LIMIT_WEBHOOK=120
RATE_LIMIT_ADMIN=90
RATE_LIMIT_AUTH=40

# Firebase Admin (phone OTP verify). Prefer JSON env on Vercel; local uses file in repo root.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=../../firebase-service-account.json
